{
  "name": "hansen",
  "version": "1.1.0",
  "description": "Desktop application for static inspection of Android APK and XAPK packages",
  "main": "dist/main/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron . --dev",
    "start": "electron .",
    "analyze": "npm run build:main && node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "build:main": "node scripts/build-main.cjs",
    "build:vite": "npm run typecheck && npm run build:main && vite build",
    "build": "npm run build:vite && electron-builder --publish never",
    "build:electron": "electron-builder --publish never",
    "package:linux": "npm run build:vite && electron-builder --linux AppImage --x64 --publish never",
    "package:windows": "npm run build:vite && electron-builder --win nsis portable --x64 --publish never",
    "package:mac:x64": "npm run build:vite && electron-builder --mac dmg zip --x64 --publish never",
    "package:mac:arm64": "npm run build:vite && electron-builder --mac dmg zip --arm64 --publish never",
    "verify:artifacts": "node scripts/verify-artifacts.cjs",
    "test": "node scripts/test.cjs",
    "test:sample": "node scripts/sample.cjs",
    "test:malware-samples": "node scripts/test-malware-samples.cjs",
    "test:electron": "npm run build:vite && node scripts/electron-test.cjs",
    "test:reputation-electron": "npm run build:vite && node scripts/reputation-electron-test.cjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-store": "^8.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.0",
    "vite": "^8.3.3",
    "wait-on": "^7.0.1"
  },
  "productName": "Hansen",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "author": "Hansen contributors",
  "desktopName": "Hansen.desktop",
  "license": "Apache-2.0"
}
